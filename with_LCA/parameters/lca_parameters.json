  "human_health_daly": {
    "internal_name": "human_health_daly",
    "reporting_only": true,
    "unit": "DALY",
    "method": [
      "IS thesis",
      "ReCiPe 2016 v1.03, midpoint-to-endpoint (H)",
      "human health",
      "total"
    ],
    "equation": "human_health_daly = sum(midpoint_score_i * human_health_damage_factor_i)",
    "contributing_midpoint_pathways": [
      "climate_change",
      "ozone_depletion",
      "ionising_radiation",
      "photochemical_ozone_formation_human_health",
      "fine_particulate_matter_formation",
      "human_carcinogenic_toxicity",
      "human_non_carcinogenic_toxicity",
      "water_consumption"
    ],
    "midpoint_to_endpoint_damage_factors": {
      "climate_change": 9.28e-07,
      "ozone_depletion": 0.000531,
      "ionising_radiation": 8.5e-09,
      "photochemical_ozone_formation_human_health": 9.1e-07,
      "fine_particulate_matter_formation": 0.000629,
      "human_carcinogenic_toxicity": 3.32e-06,
      "human_non_carcinogenic_toxicity": 2.28e-07,
      "water_consumption": 2.22e-06
    },
    "midpoint_units": {
      "climate_change": "kg CO2-eq",
      "ozone_depletion": "kg CFC-11-eq",
      "ionising_radiation": "kBq Co-60-eq",
      "photochemical_ozone_formation_human_health": "kg NOx-eq",
      "fine_particulate_matter_formation": "kg PM2.5-eq",
      "human_carcinogenic_toxicity": "kg 1,4-DCB-eq",
      "human_non_carcinogenic_toxicity": "kg 1,4-DCB-eq",
      "water_consumption": "m3 water consumed"
    },
    "direct_endpoint_validation_method": [
      "ecoinvent-3.12",
      "ReCiPe 2016 v1.03, endpoint (H)",
      "total: human health",
      "human health"
    ],
    "direct_endpoint_role": "validation_only_not_added_to_reported_daly",
    "reported_water_scarcity_relationship": "IMPACT World+ water_scarcity remains a separate reported KPI; ReCiPe water consumption potential is the midpoint feeding DALY",
    "climate_change_damage_factor_daly_per_kg_co2e": 9.28e-07,
    "manual_sut_proxy_scope": "climate_change_human_health_only",
    "source": "ReCiPe 2016 Hierarchist midpoint and midpoint-to-human-health damage factors from RIVM Report 2016-0104 as implemented in ecoinvent 3.12 ReCiPe v1.03; manual SUT GWP proxy from Reiners et al. (2026), citing Ramasamy (2018)",
